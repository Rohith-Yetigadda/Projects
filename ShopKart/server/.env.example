# ==============================================================================
# SHOPKART STUDIO EDITION — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# CRITICAL: Never commit your actual .env file or database passwords to GitHub.

# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopkart?retryWrites=true&w=majority

# JSON Web Token Secret (used to sign customer authentication tokens)
JWT_SECRET=your_jwt_super_secure_secret_key_minimum_32_chars

# Razorpay Payment Gateway Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
