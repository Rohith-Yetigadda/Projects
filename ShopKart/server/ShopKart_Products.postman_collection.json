{
  "info": {
    "name": "ShopKart - Product Catalog & Discovery (Lab 03)",
    "description": "Postman Collection for evaluating Lab 03 ShopKart Product APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Product (POST /products - 201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"description\": \"RGB mechanical keyboard with blue switches.\",\n  \"price\": 2999,\n  \"category\": \"Electronics\",\n  \"image\": \"https://example.com/keyboard.jpg\",\n  \"stock\": 10\n}"
        },
        "url": {
          "raw": "http://localhost:5000/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["products"]
        }
      }
    },
    {
      "name": "2. Create Product - Missing Field (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mechanical Keyboard\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["products"]
        }
      }
    },
    {
