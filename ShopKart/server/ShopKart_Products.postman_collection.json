          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"description\": \"RGB mechanical keyboard with blue switches.\",\n  \"price\": -50,\n  \"category\": \"Electronics\",\n  \"image\": \"https://example.com/keyboard.jpg\",\n  \"stock\": 10\n}"
        },
        "url": {
          "raw": "http://localhost:5000/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["products"]
        }
      }
    },
    {
      "name": "4. Get All Products (GET /products - 200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["products"]
        }
      }
    },
    {
      "name": "5. Search Products (GET /products?search=keyboard)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/products?search=keyboard",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["products"],
          "query": [
            {
              "key": "search",
              "value": "keyboard"
            }
          ]
        }
      }
    },
    {
      "name": "6. Filter by Category (GET /products?category=Electronics)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/products?category=Electronics",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["products"],
          "query": [
            {
              "key": "category",
              "value": "Electronics"
            }
          ]
        }
      }
    },
    {
      "name": "7. Search & Filter Combined (GET /products?search=keyboard&category=Electronics)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/products?search=keyboard&category=Electronics",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["products"],
          "query": [
            {
              "key": "search",
              "value": "keyboard"
