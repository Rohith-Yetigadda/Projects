            {
              "key": "category",
              "value": "Electronics"
            }
          ]
        }
      }
    },
    {
      "name": "8. Bonus Sorting - Price Ascending (GET /products?sort=price_asc)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/products?sort=price_asc",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["products"],
          "query": [
            {
              "key": "sort",
              "value": "price_asc"
            }
          ]
        }
      }
    },
    {
      "name": "9. Get Product By ID (GET /products/:id)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/products/YOUR_PRODUCT_ID",
